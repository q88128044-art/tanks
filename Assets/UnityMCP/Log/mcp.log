{"ts":"2026-10-15T12:55:23.945Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1860,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar tri = UnityEngine.AI.NavMesh.CalculateTriangulation();\nsb.AppendLine(\"navmesh verts=\" + tri.vertices.Length + \" indices=\" + tri.indices.Length);\n// height histogram\nvar buckets = new System.Collections.Generic.Dictionary<int,int>();\nforeach (var v in tri.vertices) { int k = Mathf.RoundToInt(v.y * 10f); buckets.TryGetValue(k, out var c); buckets[k] = c + 1; }\nforeach (var kv in buckets) sb.AppendLine(\"  y=\" + (kv.Key / 10f).ToString(\"F1\") + \" : \" + kv.Value + \" verts\");\n// tank layers\nforeach (var n in new[] { \"EnemyTank\", \"PlayerTank\" })\n{\n    var g = GameObject.Find(n);\n    int bad = 0; string badNames = \"\";\n    foreach (var t in g.GetComponentsInChildren<Transform>(true))\n    {\n        if (t.gameObject.layer != g.layer) { bad++; if (badNames.Length < 120) badNames += t.name + \"(\" + t.gameObject.layer + \") \"; }\n    }\n    sb.AppendLine(n + \" rootLayer=\" + g.layer + \" wrongLayerChildren=\" + bad + \" \" + badNames);\n    float min = float.MaxValue; string nm = \"\";\n    foreach (var c in g.GetComponentsInChildren<Collider>()) { if (c.bounds.min.y < min) { min = c.bounds.min.y; nm = c.name; } }\n    sb.AppendLine(\"   lowest collider: \" + nm + \" minY=\" + min.ToString(\"F3\") + \" rootY=\" + g.transform.position.y.ToString(\"F3\"));\n    if (UnityEngine.AI.NavMesh.SamplePosition(g.transform.position, out var h, 3f, UnityEngine.AI.NavMesh.AllAreas))\n        sb.AppendLine(\"   navmesh under it y=\" + h.position.y.ToString(\"F3\"));\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
