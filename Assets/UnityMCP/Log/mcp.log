{"ts":"2026-10-15T12:29:20.702Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1809,"action":"execute","params":{"action":"execute","code":"var profile = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Rendering.VolumeProfile>(\"Assets/Game/PostProcessing/GlobalVolumeProfile.asset\");\nif (profile == null) return \"PROFILE NOT FOUND\";\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"components=\" + profile.components.Count);\nforeach (var c in profile.components)\n{\n    sb.AppendLine(c.GetType().Name + \" active=\" + c.active + \" name=\" + c.name);\n}\nvar vol = GameObject.Find(\"Global Volume\");\nif (vol != null)\n{\n    var v = vol.GetComponent<UnityEngine.Rendering.Volume>();\n    if (v != null)\n    {\n        sb.AppendLine(\"Volume.profile=\" + (v.profile == null ? \"null\" : v.profile.name));\n        sb.AppendLine(\"Volume.isGlobal=\" + v.isGlobal + \" weight=\" + v.weight);\n        if (v.profile != null)\n        {\n            sb.AppendLine(\"Volume.profile components=\" + v.profile.components.Count);\n            foreach (var c in v.profile.components) sb.AppendLine(\"  vol-comp: \" + c.GetType().Name);\n        }\n    }\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
