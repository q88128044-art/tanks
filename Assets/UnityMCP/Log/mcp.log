{"ts":"2026-10-15T12:33:28.527Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":748,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar m = typeof(UnityEngine.Object).GetMethod(\"DestroyImmediate\", new System.Type[] { typeof(UnityEngine.Object) });\nsb.AppendLine(\"1-arg: \" + (m != null));\nvar m2 = typeof(UnityEngine.Object).GetMethod(\"DestroyImmediate\", new System.Type[] { typeof(UnityEngine.Object), typeof(bool) });\nsb.AppendLine(\"2-arg bool: \" + (m2 != null));\nforeach (var mm in typeof(UnityEngine.Object).GetMethods())\n{\n    if (mm.Name == \"DestroyImmediate\") sb.AppendLine(\"overload: \" + string.Join(\",\", System.Array.ConvertAll(mm.GetParameters(), p => p.ParameterType.Name)));\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
